{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test --require ts-node/register test/app.smoke.test.ts test/auth.security.test.ts test/cash.test.ts test/ledger.test.ts test/wallet.test.ts test/game.mapper.test.ts test/coingecko.provider.test.ts test/market.service.test.ts test/market.controller.test.ts",
    "test:integration": "node --test --test-concurrency=1 --require ts-node/register test/ledger.integration.test.ts",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "ts-node src/db/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "description": ""
}
