{
  "name": "chain-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.8",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "preview": "vite preview",
    "dev": "vite",
    "dev:server": "bun run --cwd server dev",
    "typecheck": "vue-tsc --noEmit --incremental false",
    "build": "vue-tsc && vite build",
    "build:server": "bun run --cwd server build",
    "lint": "eslint src --ext .vue,.ts,.js",
    "lint:fix": "eslint src --ext .vue,.ts,.js --fix",
    "test:server": "bun run --cwd server test",
    "check:frontend": "bun run typecheck && bun run build && bun run lint",
    "check:server": "bun run --cwd server typecheck && bun run --cwd server build && bun run --cwd server test",
    "check": "bun run check:frontend && bun run check:server",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.34",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "sass": "^1.100.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
